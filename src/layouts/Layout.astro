---
const { title = "Prasad Firame" } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Prasad Firame</title>

    <!-- favicon -->
    <link rel="icon" href="/astro.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=STIX+Two+Text:wght@400;500;600&display=swap" rel="stylesheet">
  </head>

  <body>
    <div class="page">
      <main class="container">
        <slot />

        
      </main>
    </div>
  </body>
</html>

<style is:global>
/* =========================
   GLOBAL RESET
========================= */
* {
  box-sizing: border-box;
}

html, body {
  margin: 0;
  padding: 0;
  background: #1a1a1a;
  color: #f5f5f5;
  font-family: "STIX Two Text", serif;
  line-height: 1.75;
}

/* =========================
   LINKS
========================= */
a,
a:link,
a:visited {
  display: inline;
  cursor: pointer;
  color: #f5f5f5 !important;
  text-decoration: none !important;
  background: none !important;
}

a:hover,
a:active,
a:focus {
  color: #ef4444 !important;
  text-decoration: none !important;
}

a {
  position: relative;
}

a::after {
  content: "";
  position: absolute;
  left: 0;
  bottom: -2px;
  width: 100%;
  height: 1px;
  background: #6b7280;
  opacity: 0.6;
  transform: scaleX(1);
  transform-origin: left;
  transition: transform 0.2s ease, opacity 0.2s ease;
}

a:hover::after {
  transform: scaleX(0.4);
  opacity: 1;
  background: #ef4444;
}

/* =========================
   LAYOUT
========================= */
.container {
  max-width: 650px;
  margin: 0 auto;
  padding: 5rem 1.5rem;
}

h1 {
  font-size: 1.0rem;
  margin-bottom: 1rem;
}

p {
  font-size: 1.0rem;
  color:#f5f5f5 !important;
}

/* =========================
   FOOTER
========================= */
.end-meta {
  margin-top: 4rem;
  display: flex;
  justify-content: space-between;
  font-size: 0.85rem;
  color: #a3a3a3;
  opacity: 0.75;
}
.post-date {
  color: #71717a;
  font-size: 0.92rem;
  opacity: 0.8;
}

.cursor {
  animation: blink 1s steps(1) infinite;
}

@keyframes blink {
  50% {
    opacity: 0;
  }
}
</style>