---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Artifact">

  <div style="max-width: 800px; margin: auto; padding: 2rem;">

    <h1>Artifact</h1>

    <p style="opacity: 0.7;">
      A collection of experiments, systems, and weird things I’ve built while learning.
    </p>

    <div style="margin-top: 2rem; display: grid; gap: 1rem;">

      <div style="padding: 1rem; border: 1px solid #333; border-radius: 8px;">
        <h3>Shuriken Agent SDK</h3>
        <p style="opacity: 0.8;">
          Lightweight agent orchestration layer inspired by LangGraph, but minimal and composable.
        </p>
      </div>

      <div style="padding: 1rem; border: 1px solid #333; border-radius: 8px;">
        <h3>Ink Cursor System</h3>
        <p style="opacity: 0.8;">
          Canvas-based cursor trail simulation using particle decay physics.
        </p>
      </div>

      <div style="padding: 1rem; border: 1px solid #333; border-radius: 8px;">
        <h3>Kanji Rain Engine</h3>
        <p style="opacity: 0.8;">
          Matrix-style falling character renderer tuned for aesthetic performance.
        </p>
      </div>

    </div>

  </div>

</Layout>